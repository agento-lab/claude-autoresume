# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Everything here is a shell script. A CRLF checkout breaks the shebang line
# outright -- `/usr/bin/env zsh\r` is not a program -- so line endings are not
# a style question in this repo.
* text=auto eol=lf

# Generated, not authored: keep them out of language stats and diffs.
bun.lock linguist-generated
CHANGELOG.md linguist-generated
