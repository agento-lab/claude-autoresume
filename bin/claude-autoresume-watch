#!/usr/bin/env zsh
#
# claude-autoresume-watch -- resume sessions whose usage window has rolled over.
# Run once a minute by the launchd agent.
#
# The sensor records each session's reset time and flags it armed once a window
# reads spent. This half waits for the clock, says so out loud, and puts the
# work back in motion.
#
# Usage: claude-autoresume-watch [--dry-run]
#
set -uo pipefail
source "${0:A:h}/../lib/common.sh" 2>/dev/null || exit 0
source "${0:A:h}/../lib/terminals.sh" 2>/dev/null || exit 0

DRYRUN="${CLAUDE_AUTORESUME_DRYRUN:-0}"
[[ ${1:-} == --dry-run ]] && DRYRUN=1
now=$(ar_now)

[[ -e $AUTORESUME_DIR/DISABLED ]] && { ar_log "[skip] DISABLED present"; exit 0 }
mkdir -p "$FIRED_DIR" "$MANUAL_DIR" 2>/dev/null || exit 0

# ---- collect everything whose window has rolled over -------------------------
#
# Two sources. The sensor rewrites $STATE_DIR/<sid>.json wholesale on every
# render, so a hand-armed session would be un-armed within seconds; manual arms
# live in $MANUAL_DIR, which the sensor never touches.

due=(); seen=(); typeset -A reset_of
for f in "$STATE_DIR"/*.json(N) "$MANUAL_DIR"/*.json(N); do
    armed=$(jq -r '.armed // false' "$f" 2>/dev/null) || continue
    [[ $armed == true ]] || continue
    reset=$(jq -r '.resets_at // empty' "$f" 2>/dev/null)
    [[ $reset == <-> ]] || continue
    (( now >= reset + AUTORESUME_GRACE )) || continue

    # Already acted on for this same reset. Without this the sensor's next
    # rewrite re-arms the session with the same stale resets_at -- an idle
    # session makes no API call, so the payload never refreshes -- and it fires
    # again every 60s, forever.
    sid=$(jq -r '.session_id // empty' "$f" 2>/dev/null)
    [[ -n $sid ]] && ar_already_fired "$sid" "$reset" && continue

    # Validate here rather than at resume time: a dead entry counted during
    # collection would inflate the spoken count and name a vanished directory.
    cwd=$(jq -r '.cwd // empty' "$f" 2>/dev/null)
    if [[ -z $sid || -z $cwd || ! -d $cwd ]]; then
        # Deliberately does NOT delete a manual arm. An unmounted volume or a
        # network share that has not reconnected looks identical to a deleted
        # directory, and discarding something the user set by hand on that
        # evidence cannot be undone. Marking it keeps the log quiet instead.
        ar_log "[skip] session=${sid:-?} cwd=${cwd:-none} — directory not available"
        if (( ! DRYRUN )) && [[ -n $sid ]]; then ar_mark_fired "$sid" "$reset" || true; fi
        continue
    fi

    (( ${seen[(Ie)$sid]} )) && continue       # armed by both sensor and hand
    seen+=("$sid")
    reset_of[$sid]=$reset
    due+=("$f")
done

if (( ! ${#due} )); then
    # Housekeeping only on quiet ticks, so it never delays a resume.
    find "$STATE_DIR"  -maxdepth 1 -name '*.json' -mtime +7  -delete 2>/dev/null
    find "$MANUAL_DIR" -maxdepth 1 -name '*.json' -mtime +30 -delete 2>/dev/null
    find "$FIRED_DIR"  -maxdepth 1 -name '*.json' -mtime +30 -delete 2>/dev/null
    # The fire marks are *.last, which the *.json sweep above never matched.
    find "$FIRED_DIR"  -maxdepth 1 -name '*.last' -mtime +30 -delete 2>/dev/null
    exit 0
fi

# One-at-a-time mode keeps the fresh window for the work you were last doing.
if [[ $AUTORESUME_RESUME == latest ]] && (( ${#due} > 1 )); then
    newest=$due[1] newest_m=0
    for f in $due; do
        m=$(stat -f %m "$f" 2>/dev/null || printf 0)
        (( m > newest_m )) && { newest_m=$m; newest=$f }
    done
    for f in $due; do
        [[ $f == $newest ]] && continue
        # Marked, not merely logged. Left unmarked they are still armed and still
        # due, so the next tick resumes the next one and the whole batch goes
        # through a minute apart -- which is not "only the most recent" at all.
        hsid=$(jq -r '.session_id // empty' "$f" 2>/dev/null)
        ar_log "[skipped] session=$hsid — resume=latest kept only the newest; arm it by hand to run it"
        if (( ! DRYRUN )) && [[ -n $hsid ]]; then ar_mark_fired "$hsid" "${reset_of[$hsid]:-0}" || true; fi
    done
    due=("$newest")
fi

# ---- announce, once for the whole batch --------------------------------------

n=${#due}
names=()
for f in $due; do names+=("$(basename "$(jq -r '.cwd' "$f" 2>/dev/null)")"); done
summary="${(j:, :)names}"
plural="session"; (( n > 1 )) && plural="sessions"

if (( DRYRUN )); then
    print -r -- "[dry-run] would announce: limit reset, resuming $n $plural ($summary)"
else
    command -v say >/dev/null 2>&1 && { say "Claude limit reset. Resuming $n $plural." >/dev/null 2>&1 & }
    osascript -e "display notification \"$(ar_osa_escape "$summary")\" with title \"Claude Code\" subtitle \"Limit reset — resuming $n $plural\"" >/dev/null 2>&1
fi
ar_log "[fire] $n $plural due: $summary"

# ---- resume each one ---------------------------------------------------------

waiting=()      # typed but deliberately not submitted, or left untouched

for f in $due; do
    sid=$(jq -r '.session_id // empty' "$f" 2>/dev/null)
    cwd=$(jq -r '.cwd // empty' "$f" 2>/dev/null)
    transcript=$(jq -r '.transcript_path // empty' "$f" 2>/dev/null)
    tkind=$(jq -r '.term_kind // empty' "$f" 2>/dev/null)
    tident=$(jq -r '.term_ident // empty' "$f" 2>/dev/null)
    window=$(jq -r '.armed_window // "?"' "$f" 2>/dev/null)

    # Liveness always comes from the sensor's own file: a manual arm's mtime is
    # when you armed it, which says nothing about whether Claude is still up.
    live="$STATE_DIR/${sid}.json"
    [[ -f $live ]] || live="$f"
    age=$(( now - $(stat -f %m "$live" 2>/dev/null || printf 0) ))

    # Recorded BEFORE acting. If the mark cannot be written -- fired/ present but
    # unwritable, a full disk -- resuming anyway means resuming again every 60s
    # forever, which is the bug this bookkeeping exists to prevent.
    if (( ! DRYRUN )) && ! ar_mark_fired "$sid" "${reset_of[$sid]:-0}"; then
        ar_log "[abort] session=$sid — cannot write $FIRED_DIR; refusing to resume unrecorded"
        continue
    fi

    route="" result="" mode="live-pane"
    if (( age < AUTORESUME_FRESH )) && [[ -n $tkind && -n $tident ]]; then
        route=pane
        if (( DRYRUN )); then
            result="dry-run"
        else
            result=$(ar_send_live "$tkind" "$tident" "$AUTORESUME_PROMPT")
        fi
        case $result in
            sent|dry-run) ;;
            prefilled)
                # Typed, not submitted. Deliberate -- see ar_send_live.
                waiting+=("$(basename "$cwd") (press Enter)") ;;
            skipped|unsupported-prefill)
                # The session is live, so opening a second window would run a
                # duplicate process against the same session file. Leave it be.
                waiting+=("$(basename "$cwd") (needs you)") ;;
            *)
                # A pane that has since been closed falls through to a fresh window.
                ar_log "[pane-miss] session=$sid kind=$tkind result=$result — falling back to a new window"
                route="" ;;
        esac
    fi

    if [[ -z $route ]]; then
        route=window
        mode=$(ar_last_permission_mode "$transcript")
        ar_valid_mode "$mode" || {
            [[ -n $mode ]] && ar_log "[note] session=$sid unknown permissionMode '$mode' — using settings default"
            mode="${mode:-default}"
        }
        kind=$(ar_pick_terminal "$AUTORESUME_TERMINAL")
        # Prefer the terminal the session came from, but only if it can still be
        # driven. Trusting the recorded value blindly sent sessions straight to
        # the headless fallback when tmux had exited, never trying a live iTerm.
        if [[ $AUTORESUME_TERMINAL == auto && -n $tkind ]] && ar_terminal_usable "$tkind"; then
            kind=$tkind
        fi
        if (( DRYRUN )); then
            result="dry-run: [$kind] $(ar_build_cmd "$cwd" "$sid" "$mode" "$AUTORESUME_PROMPT")"
        else
            result=$(ar_open_new "$kind" "$cwd" "$sid" "$mode" "$AUTORESUME_PROMPT")
            [[ $result == opened* ]] || {
                ar_log "[fallback] session=$sid $kind failed ($result) — going headless"
                result=$(ar_open_new headless "$cwd" "$sid" "$mode" "$AUTORESUME_PROMPT")
            }
        fi
        route="window:$kind"
    fi

    ar_log "[resume] session=$sid window=$window route=$route mode=$mode result=$result cwd=$cwd"

    if (( ! DRYRUN )); then
        mv -f "$f" "$FIRED_DIR/${sid}.$(date +%Y%m%d-%H%M%S).json" 2>/dev/null
        rm -f "$MANUAL_DIR/${sid}.json" 2>/dev/null
    fi
done

if (( ${#waiting} )); then
    w=${#waiting}
    ws="${(j:, :)waiting}"
    wp="session is"; (( w > 1 )) && wp="sessions are"
    if (( DRYRUN )); then
        print -r -- "[dry-run] would announce: $w $wp waiting on you ($ws)"
    else
        command -v say >/dev/null 2>&1 && { say "$w Claude $wp waiting on you." >/dev/null 2>&1 & }
        osascript -e "display notification \"$(ar_osa_escape "$ws")\" with title \"Claude Code\" subtitle \"Typed, not submitted — press Enter\"" >/dev/null 2>&1
    fi
    ar_log "[waiting] $w $wp waiting on a keypress: $ws"
fi
