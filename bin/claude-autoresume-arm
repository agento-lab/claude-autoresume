#!/usr/bin/env zsh
#
# claude-autoresume-arm -- arm a session by hand.
#
# The sensor arms automatically once a usage window reads spent
# (100% by default; see AUTORESUME_ARM_PCT). This is the
# override for when it doesn't: the window tops out a hair under, or you simply
# want a resume at a time of your choosing.
#
# Usage:
#   claude-autoresume-arm                    most recent session, at its own 5h reset
#   claude-autoresume-arm --in 2h30m         ... at a time you pick
#   claude-autoresume-arm --at 1787030000    ... at an exact epoch second
#   claude-autoresume-arm --session <id>     target a specific session
#   claude-autoresume-arm --list             what the sensor has recorded
#   claude-autoresume-arm --disarm [--session <id>]
#
set -uo pipefail
source "${0:A:h}/../lib/common.sh" 2>/dev/null || exit 1
now=$(ar_now)

sid="" at="" in_="" mode=arm
# zsh's `shift 2` with one argument left errors *and does not shift*, unlike
# bash. Without this guard `--session` with no value loops forever printing
# "shift count must be <= $#".
need() { (( $# >= 2 )) || { print -u2 -- "$1 needs a value"; exit 2 } }

while (( $# )); do
    case $1 in
        --session) need "$@"; sid=$2; shift 2 ;;
        --in)      need "$@"; in_=$2; shift 2 ;;
        --at)      need "$@"; at=$2; shift 2 ;;
        --disarm)  mode=disarm; shift ;;
        --list)    mode=list; shift ;;
        # Bounded by the end of the header block rather than a fixed line
        # number, which had rotted and was printing three lines of source.
        -h|--help) sed -n '2,/^[^#]/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) print -u2 -- "unknown argument: $1"; exit 2 ;;
    esac
done

files=("$STATE_DIR"/*.json(Nom))     # newest first -- Om is oldest first, om is newest
(( ${#files} )) || { print -u2 -- "no sessions recorded yet in $STATE_DIR
(the sensor writes one the moment any Claude session renders its status line)"; exit 1 }

if [[ $mode == list ]]; then
    for f in $files; do
        [[ $(jq -r '.session_id // "null"' "$f" 2>/dev/null) == null ]] && continue
        jq -r '"\(.session_id)  armed=\(.armed)  5h=\(.five_hour.used_percentage)%  7d=\(.seven_day.used_percentage)%  \(.cwd)"' "$f" 2>/dev/null
    done
    exit 0
fi

target=""
if [[ -n $sid ]]; then
    [[ -f $STATE_DIR/$sid.json ]] || { print -u2 -- "no state for session $sid"; exit 1 }
    target="$STATE_DIR/$sid.json"
else
    target=$files[1]
fi

# Manual arms live in their own directory: the sensor rewrites its own copy from
# scratch on every render, so an arm written there would be erased in seconds.
mkdir -p "$MANUAL_DIR" || { print -u2 -- "cannot create $MANUAL_DIR"; exit 1 }

# `// empty` matters: without it a jq failure yields the string "null", and the
# arm lands in $MANUAL_DIR/null.json -- or, with a bare `.session_id` on a
# malformed file, in .json, which every *.json glob skips as a dotfile.
tsid=$(jq -r '.session_id // empty' "$target" 2>/dev/null)
[[ -n $tsid ]] || { print -u2 -- "no session_id in $target"; exit 1 }

if [[ $mode == disarm ]]; then
    # Removing the manual arm alone is not enough. The common case is a session
    # the *sensor* armed, whose state file it rewrites every 15s -- deleting
    # anything there would be undone within seconds. Marking the current reset
    # as already handled is what actually stops it firing, and a genuinely new
    # window carries a different reset and arms again as it should.
    had_manual=0
    [[ -f $MANUAL_DIR/${tsid}.json ]] && had_manual=1
    rm -f "$MANUAL_DIR/${tsid}.json" 2>/dev/null
    treset=$(jq -r '.resets_at // empty' "$target" 2>/dev/null)
    marked=0
    if [[ $treset == <-> ]]; then
        # The watcher already refuses to act on an unwritable mark; arm reported
        # success regardless, leaving a sensor-armed session to resume anyway.
        if ar_mark_fired "$tsid" "$treset"; then
            marked=1
        else
            print -u2 -- "removed the manual arm, but could not record the disarm in $FIRED_DIR"
            print -u2 -- "$tsid is still armed by the sensor and will resume"
            exit 1
        fi
    fi
    if (( had_manual || marked )); then
        print -r -- "disarmed $tsid"
    else
        print -r -- "$tsid was not armed"
    fi
    exit 0
fi

reset=""
if [[ -n $at ]]; then
    [[ $at == <-> ]] || { print -u2 -- "--at wants an epoch second"; exit 2 }
    reset=$at
elif [[ -n $in_ ]]; then
    # =~ rather than a (#b) glob: backreferences need extendedglob, which is off
    # by default in a script and would silently match nothing.
    secs=0 rest=$in_
    while [[ $rest =~ '^([0-9]+)([hms])' ]]; do
        case $match[2] in
            h) (( secs += match[1] * 3600 )) ;;
            m) (( secs += match[1] * 60 )) ;;
            s) (( secs += match[1] )) ;;
        esac
        rest=${rest#$MATCH}
    done
    (( secs > 0 )) || { print -u2 -- "--in wants something like 2h30m, 90m or 45s"; exit 2 }
    reset=$(( now + secs ))
else
    reset=$(jq -r '.five_hour.resets_at // empty' "$target" 2>/dev/null)
    [[ $reset == <-> ]] || { print -u2 -- "no 5-hour reset recorded for this session — pass --in or --at"; exit 1 }
fi

# Reported success used to be unconditional, so a failed write still printed
# "armed" and exited 0 while nothing existed on disk to fire.
tmp=$(mktemp) || { print -u2 -- "cannot create a temporary file"; exit 1 }
if ! jq --argjson r "$reset" \
        '.armed=true | .resets_at=$r | .armed_window="manual"' "$target" > "$tmp"; then
    rm -f "$tmp"; print -u2 -- "could not rewrite state for $tsid"; exit 1
fi
mv -f "$tmp" "$MANUAL_DIR/${tsid}.json" || {
    rm -f "$tmp"; print -u2 -- "could not write $MANUAL_DIR/${tsid}.json"; exit 1
}
# A hand-arm overrides an earlier disarm or a previous fire for this reset.
rm -f "$(ar_fired_mark "$tsid")" 2>/dev/null

left=$(( reset - now )); (( left < 0 )) && left=0
printf 'armed %s\n  resumes at %s (in %dh%02dm)\n  cwd %s\n' \
    "$tsid" "$(date -r "$reset" '+%a %H:%M')" \
    $(( left / 3600 )) $(( left % 3600 / 60 )) "$(jq -r .cwd "$target")"
